# Copy this file to .env and fill in your real values.
# Run with: node --env-file=.env create_templates.js

# "production" or "uat"
WA_ENV=production

# Found in Smartta portal settings / Sinch onboarding docs
WA_WABA_ID=

# Sinch/ACL API credentials issued at onboarding (not your portal login)
WA_USERNAME=
WA_PASSWORD=

# Pause between template creation requests, in ms
WA_DELAY_MS=1500

# server.js only: receives a live template message the instant a pending
# template flips to APPROVED (WhatsApp requires an approved template to
# message someone first, so this re-sends that template with its example
# values). Leave blank to disable auto-notify.
WA_TEST_NUMBER=

# server.js only: how often (ms) to check pending templates for approval
WA_APPROVAL_POLL_MS=180000
